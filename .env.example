# --- Required ---
# Bearer token for the Statiq API replica (https://harrier-evroute.aaravnirajsingh.workers.dev/api).
# Server-side only: never sent to the browser, never logged.
STATIQ_API_TOKEN=

# --- Optional: AI trip planning (any OpenAI-compatible provider) ---
# AI planning is OFF unless ALL three are set.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Local browser-origin policy (development only). Exact origins, comma separated:
# INDEV_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Launchers pin this to their own web port. No public host/TLS policy is established.
